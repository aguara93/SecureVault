@page "/sensors/{SensorId:int}"
@implements IAsyncDisposable
@using SecureVault.Shared.DTOs
@using SecureVault.Client.Services
@inject SensorService SensorService
@inject AuthService AuthService
@inject NavigationManager Navigation
@inject IJSRuntime JsRuntime

<h1>Sensor Readings History</h1>

@if (isLoading)
{
    <p>Loading...</p>
}
else if (readings == null || !readings.Any())
{
    <p>No readings found for this sensor.</p>
}
else
{
    <canvas id="sensorChart" width="600" height="300"></canvas>

    <table>
        <thead>
            <tr>
                <th>Value</th>
                <th>Unit</th>
                <th>Timestamp</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var reading in readings)
            {
                <tr>
                    <td>@reading.Value</td>
                    <td>@reading.Unit</td>
                    <td>@reading.Timestamp</td>
                </tr>
            }
        </tbody>
    </table>
}

<a href="/dashboard">Back to Dashboard</a>

@code {
    [Parameter]
    public int SensorId { get; set; }

    private List<SensorReadingDto>? readings;
    private bool isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        if (!AuthService.IsLoggedIn)
        {
            Navigation.NavigateTo("/login");
            return;
        }

        readings = await SensorService.GetSensorReadingsAsync(SensorId);
        isLoading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (readings != null && readings.Any())
        {
            // Order readings chronologically for the chart
            var orderedReadings = readings.OrderBy(r => r.Timestamp).ToList();
            var labels = orderedReadings.Select(r => r.Timestamp.ToString("HH:mm:ss")).ToArray();
            var values = orderedReadings.Select(r => r.Value).ToArray();

            await JsRuntime.InvokeVoidAsync("renderChart", "sensorChart", labels, values);
        }
    }

    public ValueTask DisposeAsync()
    {
        return ValueTask.CompletedTask;
    }
}